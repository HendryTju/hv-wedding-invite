  <script type="module">
    import { getWeddingRundown, saveWeddingRundown } from '/rundown-api.js';
    
    document.addEventListener('DOMContentLoaded', async () => {
      const editor = document.getElementById('rundown-editor');
      const statusBar = document.getElementById('status-bar');
      const statusText = document.getElementById('status-text');
      const statusDot = document.getElementById('status-dot');
      const initialHtml = editor.innerHTML; // Default content if DB is empty

      // Fetch latest
      try {
        const savedHtml = await getWeddingRundown();
        if (savedHtml) {
          editor.innerHTML = savedHtml;
        }
      } catch (err) {
        console.error('Error loading rundown, using default:', err);
      }
      
      // Auto-save logic
      let timeoutId = null;

      function updateStatus(state) {
        statusBar.classList.remove('opacity-0');
        if (state === 'saving') {
          statusText.textContent = 'Saving...';
          statusText.classList.remove('text-green-600', 'text-red-500');
          statusText.classList.add('text-yellow-600');
          statusDot.querySelector('.bg-green-500').classList.replace('bg-green-500', 'bg-yellow-500');
          statusDot.querySelector('.animate-ping').classList.remove('hidden');
          statusDot.querySelector('.animate-ping').classList.replace('bg-green-400', 'bg-yellow-400');
        } else if (state === 'saved') {
          statusText.textContent = 'Saved';
          statusText.classList.remove('text-yellow-600', 'text-red-500');
          statusText.classList.add('text-green-600');
          statusDot.querySelector('.bg-yellow-500').classList.replace('bg-yellow-500', 'bg-green-500');
          statusDot.querySelector('.animate-ping').classList.add('hidden');
          statusDot.querySelector('.animate-ping').classList.replace('bg-yellow-400', 'bg-green-400');
          setTimeout(() => statusBar.classList.add('opacity-0'), 2000);
        } else if (state === 'error') {
          statusText.textContent = 'Error saving';
          statusText.classList.remove('text-yellow-600', 'text-green-600');
          statusText.classList.add('text-red-500');
          statusDot.querySelector('.bg-yellow-500')?.classList.replace('bg-yellow-500', 'bg-red-500');
          statusDot.querySelector('.bg-green-500')?.classList.replace('bg-green-500', 'bg-red-500');
          statusDot.querySelector('.animate-ping').classList.add('hidden');
        }
      }

      editor.addEventListener('input', () => {
        updateStatus('saving');
        
        clearTimeout(timeoutId);
        timeoutId = setTimeout(async () => {
          try {
            await saveWeddingRundown(editor.innerHTML);
            updateStatus('saved');
          } catch (err) {
            console.error('Save failed', err);
            updateStatus('error');
          }
        }, 1500); // 1.5 seconds debounce
      });

      // Prevent default form submissions if inside forms
      editor.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && e.ctrlKey) {
           // allow maybe some formatting shortcuts
        }
      });
    });
  </script>
