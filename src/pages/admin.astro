---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin - RSVP List">
  <!-- PIN Protection Overlay -->
  <div id="pin-overlay" class="fixed inset-0 bg-[#314a31] z-[100] flex flex-col items-center justify-center text-[#fbf4e6] p-4 transition-opacity duration-500">
    <h2 class="font-serif italic text-4xl mb-6 font-bold">Admin Access</h2>
    <div class="flex flex-col gap-4 w-full max-w-xs">
      <input type="password" id="pin-input" maxlength="6" inputmode="numeric" class="w-full text-center text-3xl tracking-[10px] p-4 rounded-2xl bg-[#253825] border border-white/10 outline-none focus:ring-2 ring-primary text-[#fbf4e6] placeholder-[#fbf4e6]/30 font-mono" placeholder="••••••">
      <button id="pin-submit" class="w-full bg-primary text-[#314a31] font-bold uppercase tracking-widest p-4 rounded-2xl hover:bg-[#fff0b3] transition-colors mt-2">Unlock</button>
      <p id="pin-error" class="text-red-400 text-sm text-center font-bold tracking-widest uppercase opacity-0 transition-opacity">Incorrect PIN</p>
    </div>
    <a href="/" class="mt-8 text-xs font-bold uppercase tracking-widest hover:underline opacity-70">← Back to Website</a>
  </div>

  <div id="admin-content" class="min-h-screen bg-[#fbf4e6] text-[#2c402c] p-6 lg:p-12 font-sans selection:bg-[#314a31] selection:text-[#fbf4e6] hidden">
    <div class="max-w-7xl mx-auto">
      
      <div class="flex justify-between items-end mb-8">
        <div>
          <h1 class="font-serif italic text-4xl md:text-5xl text-[#314a31] font-bold drop-shadow-sm">Guest RSVPs</h1>
          <p class="text-sm font-bold uppercase tracking-widest opacity-60 mt-2">Live Database View</p>
        </div>
        <a href="/" class="text-xs font-bold uppercase tracking-widest text-[#314a31] hover:underline bg-[#314a31]/10 px-4 py-2 rounded-full transition-colors">← Logout</a>
      </div>
      
      <div class="flex flex-wrap items-center gap-4 mb-8">
        <button id="btn-toggle-add" class="text-xs font-bold uppercase tracking-widest border-2 border-[#314a31] bg-[#314a31] text-white px-6 py-3 rounded-full hover:bg-transparent hover:text-[#314a31] transition-colors">
          + Add Guest
        </button>
        <div class="text-sm font-bold tracking-widest bg-[#314a31] text-white px-6 py-3 rounded-full">
          Confirmed Pax: <span id="total-pax">0</span>
        </div>
      </div>

      <form id="add-guest-form" class="hidden flex-wrap items-end gap-4 bg-white/50 p-6 rounded-xl mb-8 border border-[#314a31]/10 shadow-sm">
        <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
          <label class="text-xs font-bold uppercase text-[#314a31]">Name</label>
          <input type="text" name="name" required class="border-b-2 border-[#314a31]/30 p-2 bg-transparent outline-none focus:border-[#314a31]" placeholder="Guest Name">
        </div>
        <div class="flex flex-col gap-1 w-24">
          <label class="text-xs font-bold uppercase text-[#314a31]">Pax</label>
          <input type="number" name="pax" required min="1" class="border-b-2 border-[#314a31]/30 p-2 bg-transparent text-center outline-none focus:border-[#314a31]" value="1">
        </div>
        <div class="flex flex-col gap-1 flex-1 min-w-[150px]">
          <label class="text-xs font-bold uppercase text-[#314a31]">Diet/Notes</label>
          <input type="text" name="diet" class="border-b-2 border-[#314a31]/30 p-2 bg-transparent outline-none focus:border-[#314a31]" placeholder="None">
        </div>
        <div class="flex flex-col gap-1 w-32">
          <label class="text-xs font-bold uppercase text-[#314a31]">Family Of</label>
          <select name="familyOf" class="border-b-2 border-[#314a31]/30 p-2 bg-transparent outline-none focus:border-[#314a31]">
            <option value="">- Select -</option>
            <option value="Hendry">Hendry</option>
            <option value="Valensia">Valensia</option>
            <option value="Both">Both</option>
          </select>
        </div>
        <button type="submit" id="btn-submit-guest" class="bg-[#314a31] text-white font-bold uppercase px-6 py-2 rounded-full h-[42px] hover:bg-[#253825] transition-colors">
          Save
        </button>
      </form>

      <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-[#314a31]/10">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-[#314a31] text-[#fbf4e6] text-xs uppercase tracking-[2px]">
                <th class="p-5 font-black">Date</th>
                <th class="p-5 font-black">Name</th>
                <th class="p-5 font-black text-center">Pax</th>
                <th class="p-5 font-black">Notes/Diet</th>
                <th class="p-5 font-black">Family Of</th>
                <th class="p-5 font-black text-center">Confirm</th>
                <th class="p-5 font-black text-center">Delete</th>
              </tr>
            </thead>
            <tbody id="rsvp-table-body" class="divide-y divide-[#314a31]/10 text-sm font-medium">
              <tr>
                <td colspan="7" class="p-12 text-center text-black/50 font-bold animate-pulse">Loading RSVPs from Database...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      
    </div>
  </div>

  <script type="module">
    import { getAllRsvps, toggleRsvpConfirm, updateRsvpAdminFields, adminAddRsvp } from '/rsvp.js';

    // PIN LOGIC (Uses wedding date as default PIN)
    const CORRECT_PIN = '061226';
    
    const pinOverlay = document.getElementById('pin-overlay');
    const adminContent = document.getElementById('admin-content');
    const pinInput = document.getElementById('pin-input');
    const pinSubmit = document.getElementById('pin-submit');
    const pinError = document.getElementById('pin-error');

    function checkPin() {
      if (pinInput.value === CORRECT_PIN) {
        pinOverlay.classList.add('opacity-0');
        setTimeout(() => {
          pinOverlay.classList.add('hidden');
          adminContent.classList.remove('hidden');
          loadRsvps();
        }, 500);
      } else {
        pinError.classList.remove('opacity-0');
        pinInput.value = '';
        pinInput.focus();
        setTimeout(() => pinError.classList.add('opacity-0'), 2000);
      }
    }

    pinSubmit.addEventListener('click', checkPin);
    pinInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') checkPin();
    });
    
    window.addEventListener('DOMContentLoaded', () => {
      pinInput.focus();
    });

    // Setup Add Guest Form Toggle
    const addGuestForm = document.getElementById('add-guest-form');
    document.getElementById('btn-toggle-add').addEventListener('click', () => {
      addGuestForm.classList.toggle('hidden');
      addGuestForm.classList.toggle('flex');
    });

    // Setup Submit New Guest
    addGuestForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-submit-guest');
      btn.textContent = 'Saving...';
      
      const formData = new FormData(addGuestForm);
      await adminAddRsvp({
        name: formData.get('name'),
        pax: parseInt(formData.get('pax')),
        diet: formData.get('diet') || 'None',
        familyOf: formData.get('familyOf')
      });
      
      addGuestForm.reset();
      addGuestForm.classList.add('hidden');
      addGuestForm.classList.remove('flex');
      btn.textContent = 'Save';
      await loadRsvps();
    });

    // Helper to prevent XSS
    function escapeHTML(str) {
      if (!str) return '';
      return String(str).replace(/[&<>'"]/g, 
        tag => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#39;',
            '"': '&quot;'
          }[tag] || tag)
      );
    }

    // Load the Table
    async function loadRsvps() {
      const tbody = document.getElementById('rsvp-table-body');
      
      try {
        let rsvps = await getAllRsvps();
        rsvps = rsvps.filter(r => r.deleted !== true); // Hide deleted
        
        if (rsvps.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="p-12 text-center text-black/50 font-bold">No RSVPs yet.</td></tr>';
          document.getElementById('total-pax').textContent = '0';
          return;
        }

        let totalConfirmedPax = 0;
        tbody.innerHTML = '';
        
        rsvps.forEach(rsvp => {
          if (rsvp.confirmed) {
            totalConfirmedPax += parseInt(rsvp.pax || 0);
          }
          
          const sourceBadge = rsvp.source === 'admin' 
            ? '<span class="text-[10px] bg-blue-100 text-blue-800 px-2 py-0.5 rounded ml-2 uppercase font-bold">Admin</span>'
            : '<span class="text-[10px] bg-gray-200 text-gray-700 px-2 py-0.5 rounded ml-2 uppercase font-bold">Form</span>';
            
          const dateStr = rsvp.timestamp ? new Date(rsvp.timestamp).toLocaleDateString('en-GB', { 
            day: 'numeric', month: 'short', year: 'numeric' 
          }) : '';

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[#314a31]/5 transition-colors group';
          tr.innerHTML = `
            <td class="p-5 text-xs opacity-60 whitespace-nowrap font-bold">${dateStr}</td>
            <td class="p-5 font-bold whitespace-nowrap text-base">${escapeHTML(rsvp.name)}${sourceBadge}</td>
            <td class="p-5 font-black text-[#314a31] text-center text-lg">${escapeHTML(String(rsvp.pax))}</td>
            <td class="p-5 italic text-xs max-w-[250px] opacity-80 break-words">${escapeHTML(rsvp.diet || rsvp.wishes || 'None')}</td>
            <td class="p-5">
              <select class="field-family bg-transparent border-b border-[#314a31]/30 outline-none" data-id="${rsvp.id}">
                <option value="" ${!rsvp.familyOf ? 'selected' : ''}>- Select -</option>
                <option value="Hendry" ${rsvp.familyOf === 'Hendry' ? 'selected' : ''}>Hendry</option>
                <option value="Valensia" ${rsvp.familyOf === 'Valensia' ? 'selected' : ''}>Valensia</option>
                <option value="Both" ${rsvp.familyOf === 'Both' ? 'selected' : ''}>Both</option>
              </select>
            </td>
            <td class="p-5 text-center">
              <button class="toggle-btn text-2xl hover:scale-110 transition-transform ${rsvp.confirmed ? 'text-green-500' : 'text-gray-300'}" data-id="${rsvp.id}" data-status="${rsvp.confirmed}" data-pax="${rsvp.pax || 0}">✓</button>
            </td>
            <td class="p-5 text-center">
              <button class="delete-btn text-red-500 text-xl hover:scale-110 transition-transform" data-id="${rsvp.id}">🗑️</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
        
        document.getElementById('total-pax').textContent = totalConfirmedPax;
        
        // Attach Family dropdown listeners (Optimistic)
        document.querySelectorAll('.field-family').forEach(select => {
          select.addEventListener('change', (e) => {
            const id = e.target.getAttribute('data-id');
            updateRsvpAdminFields(id, { familyOf: e.target.value }).catch(console.error);
          });
        });
        
        // Attach Delete listeners (Optimistic)
        document.querySelectorAll('.delete-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            if(!confirm('Remove this guest?')) return;
            const id = e.currentTarget.getAttribute('data-id');
            
            // Immediate UI feedback
            const tr = e.currentTarget.closest('tr');
            if (tr) tr.style.display = 'none';
            
            updateRsvpAdminFields(id, { deleted: true })
              .then(() => loadRsvps()) // Reload in background to resync totals
              .catch(err => {
                console.error(err);
                if (tr) tr.style.display = ''; // Revert on fail
              });
          });
        });

        // Attach Toggle listeners (Optimistic)
        document.querySelectorAll('.toggle-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const el = e.currentTarget;
            const id = el.getAttribute('data-id');
            const status = el.getAttribute('data-status') === 'true';
            const pax = parseInt(el.getAttribute('data-pax') || '0');
            const newStatus = !status;
            
            // Immediate UI update
            el.setAttribute('data-status', String(newStatus));
            if (newStatus) {
              el.classList.remove('text-gray-300');
              el.classList.add('text-green-500');
              totalConfirmedPax += pax;
            } else {
              el.classList.remove('text-green-500');
              el.classList.add('text-gray-300');
              totalConfirmedPax -= pax;
            }
            document.getElementById('total-pax').textContent = totalConfirmedPax;

            // Background network request
            toggleRsvpConfirm(id, status).catch(err => {
              console.error(err);
              // Revert on fail
              el.setAttribute('data-status', String(status));
              if (status) {
                el.classList.remove('text-gray-300');
                el.classList.add('text-green-500');
                totalConfirmedPax += pax;
              } else {
                el.classList.remove('text-green-500');
                el.classList.add('text-gray-300');
                totalConfirmedPax -= pax;
              }
              document.getElementById('total-pax').textContent = totalConfirmedPax;
            });
          });
        });
        
      } catch (error) {
        console.error(error);
        tbody.innerHTML = '<tr><td colspan="7" class="p-12 text-center text-red-700 font-bold bg-red-50">Error connecting to database.</td></tr>';
      }
    }
  </script>
</Layout>
