---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rundown Pernikahan - Hendry & Valensia" description="Rundown Lengkap Acara Pernikahan Hendry & Valensia Huang - Minggu, 6 Desember 2026">
  <div class="min-h-screen bg-[#fcfaf7] text-[#2c402c] font-sans selection:bg-[#314a31] selection:text-[#fbf4e6]">
    
    <!-- Top Sticky Navigation Bar -->
    <header class="sticky top-0 z-40 bg-[#314a31]/95 backdrop-blur-md text-[#fbf4e6] border-b border-[#fbf4e6]/10 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <a href="/" class="p-2 rounded-full hover:bg-white/10 transition-colors" title="Kembali ke Undangan">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
          </a>
          <div>
            <h1 class="font-serif italic text-lg sm:text-xl font-bold tracking-wide text-primary">H &amp; V Wedding Rundown</h1>
            <p class="text-[11px] sm:text-xs text-[#fbf4e6]/80 font-medium tracking-wider">Minggu, 6 Desember 2026 • Hotel Harris Puri Mansion</p>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Quick Print Button -->
          <button onclick="window.print()" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider bg-white/10 hover:bg-white/20 text-[#fbf4e6] px-3.5 py-2 rounded-full transition-all border border-white/10">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            <span class="hidden sm:inline">Cetak</span>
          </button>

          <!-- Quick Copy Summary Button -->
          <button id="copy-summary-btn" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider bg-primary text-[#314a31] hover:bg-yellow-200 px-4 py-2 rounded-full transition-all shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
            </svg>
            <span id="copy-text">Salin Jadwal</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Hero / Header Section -->
    <section class="bg-gradient-to-b from-[#314a31] to-[#253825] text-[#fbf4e6] py-12 px-4 sm:px-6 lg:px-8 shadow-inner">
      <div class="max-w-6xl mx-auto text-center space-y-4">
        <span class="inline-block text-xs font-bold uppercase tracking-[4px] bg-primary/20 text-primary px-4 py-1.5 rounded-full border border-primary/30">
          Official Master Schedule &amp; To-Do
        </span>
        <h1 class="font-serif italic text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#fbf4e6]">
          Rundown Acara Pernikahan
        </h1>
        <p class="font-serif text-2xl sm:text-3xl text-primary font-medium">
          Hendry &amp; Valensia Huang
        </p>

        <!-- Key Meta Info Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto pt-4 text-left">
          <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10">
            <p class="text-[10px] uppercase font-bold tracking-wider text-primary">Hari &amp; Tanggal</p>
            <p class="text-sm sm:text-base font-bold mt-1">Minggu, 06 Des 2026</p>
            <p class="text-[11px] opacity-75">Dimulai 05.30 WIB</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10">
            <p class="text-[10px] uppercase font-bold tracking-wider text-primary">Pemberkatan Gereja</p>
            <p class="text-sm sm:text-base font-bold mt-1">13.00 – 15.00 WIB</p>
            <p class="text-[11px] opacity-75">St. Thomas Rasul, Bojong</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10">
            <p class="text-[10px] uppercase font-bold tracking-wider text-primary">Teapai Keluarga</p>
            <p class="text-sm sm:text-base font-bold mt-1">17.30 – 18.30 WIB</p>
            <p class="text-[11px] opacity-75">Productive Room Lt. 1</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/10">
            <p class="text-[10px] uppercase font-bold tracking-wider text-primary">Resepsi Makan Malam</p>
            <p class="text-sm sm:text-base font-bold mt-1">19.00 – 21.00 WIB</p>
            <p class="text-[11px] opacity-75">Hotel Harris (400 Pax)</p>
          </div>
        </div>

        <!-- Pending Items Alert Banner -->
        <div class="mt-6 p-4 bg-amber-500/20 border border-amber-400/40 rounded-2xl text-left max-w-4xl mx-auto flex items-start gap-3 text-amber-200 text-xs sm:text-sm">
          <svg class="w-5 h-5 flex-shrink-0 text-amber-300 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <div>
            <span class="font-bold text-amber-100 uppercase tracking-wider">Perhatian / Poin Yang Perlu Dikonfirmasi (Pending):</span>
            <ul class="mt-1 list-disc list-inside space-y-0.5 text-[12px] opacity-90">
              <li><strong>Harris Hotel:</strong> Konfirmasi ruangan VIP tunggu pengantin &amp; penyediaan teh/cangkir/teko Teapai.</li>
              <li><strong>WO Sky:</strong> Standby pagi (disarankan standby sejak 05.30 untuk makeup), konfirmasi singer entertainment, usher 1-2, dan durasi pengiriman video slideshow.</li>
              <li><strong>Libra Cake:</strong> Konfirmasi jatah kue mingle dan kue suap-suapan.</li>
              <li><strong>Shandy's Catering:</strong> Box konsumsi pemberkatan diupdate menjadi 70 box (sebelumnya 50 box).</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Navigation Tabs & Search Controls -->
    <div class="sticky top-[58px] z-30 bg-[#fcfaf7]/95 backdrop-blur-md border-b border-[#314a31]/10 py-3 px-4 shadow-sm">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
        <!-- Filter Tabs -->
        <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0 text-xs font-semibold no-scrollbar">
          <button data-filter="all" class="tab-btn px-4 py-2 rounded-full transition-all bg-[#314a31] text-[#fbf4e6] shadow-sm whitespace-nowrap">
            Semua Acara
          </button>
          <button data-filter="morning" class="tab-btn px-4 py-2 rounded-full transition-all bg-white text-[#2c402c] hover:bg-black/5 border border-black/5 whitespace-nowrap">
            🌅 Pagi &amp; Makeup
          </button>
          <button data-filter="pickup" class="tab-btn px-4 py-2 rounded-full transition-all bg-white text-[#2c402c] hover:bg-black/5 border border-black/5 whitespace-nowrap">
            🚪 Penjemputan
          </button>
          <button data-filter="church" class="tab-btn px-4 py-2 rounded-full transition-all bg-white text-[#2c402c] hover:bg-black/5 border border-black/5 whitespace-nowrap">
            ⛪ Pemberkatan
          </button>
          <button data-filter="teapai" class="tab-btn px-4 py-2 rounded-full transition-all bg-white text-[#2c402c] hover:bg-black/5 border border-black/5 whitespace-nowrap">
            🍵 Teapai
          </button>
          <button data-filter="reception" class="tab-btn px-4 py-2 rounded-full transition-all bg-white text-[#2c402c] hover:bg-black/5 border border-black/5 whitespace-nowrap">
            🎉 Resepsi
          </button>
          <button data-filter="todo" class="tab-btn px-4 py-2 rounded-full transition-all bg-white text-[#2c402c] hover:bg-black/5 border border-black/5 whitespace-nowrap">
            ✅ To-Do &amp; Checklist
          </button>
          <button data-filter="contacts" class="tab-btn px-4 py-2 rounded-full transition-all bg-white text-[#2c402c] hover:bg-black/5 border border-black/5 whitespace-nowrap">
            👥 Vendor &amp; PIC
          </button>
        </div>

        <!-- Realtime Search Input -->
        <div class="relative w-full md:w-64 flex-shrink-0">
          <input type="text" id="schedule-search" placeholder="Cari kegiatan, PIC, lokasi..." class="w-full pl-9 pr-4 py-2 text-xs bg-white rounded-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#314a31] focus:border-transparent transition-all shadow-inner" />
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">

      <!-- ========================================== -->
      <!-- SECTION 1: PERSIAPAN DI TEMPAT PRIA & WANITA -->
      <!-- ========================================== -->
      <section id="section-morning" class="schedule-section space-y-6" data-category="morning">
        <div class="flex items-center justify-between border-b-2 border-[#314a31]/20 pb-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#314a31]">Fase 1 • 05.30 – 10.00 WIB</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#314a31]">Persiapan &amp; Makeup (Tempat Pria &amp; Wanita)</h2>
          </div>
          <span class="text-xs font-semibold bg-[#314a31]/10 text-[#314a31] px-3 py-1 rounded-full">Hotel Harris Puri Mansion</span>
        </div>

        <!-- Two Column Comparison / Mobile Stack for Groom & Bride Morning Prep -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- GROOM PREPARATION CARD -->
          <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-sm border border-gray-200/80 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-gray-100">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-sm">🤵</span>
                <div>
                  <h3 class="font-bold text-lg text-gray-900">Persiapan Tempat Pria (Hendry)</h3>
                  <p class="text-xs text-gray-500">Kamar Pengantin Pria • Harris Puri Mansion</p>
                </div>
              </div>
              <span class="text-[11px] font-bold bg-blue-100 text-blue-800 px-2.5 py-1 rounded-full uppercase tracking-wider">Keluarga Groom</span>
            </div>

            <!-- Members list -->
            <div class="bg-gray-50 rounded-2xl p-4 text-xs text-gray-700 space-y-2 border border-gray-100">
              <p class="font-bold uppercase tracking-wider text-gray-500 text-[10px]">Keluarga Yang Menginap:</p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                <li><span class="font-semibold">Groom:</span> Hendry</li>
                <li><span class="font-semibold">Papa:</span> Tn. Tju Shin Tjhong</li>
                <li><span class="font-semibold">Mama:</span> Ny. Susana</li>
                <li><span class="font-semibold">Saudara:</span> Hendra</li>
                <li class="sm:col-span-2"><span class="font-semibold">Saudara:</span> Harris &amp; Carolina Laimena Sanjaya &amp; Caiden</li>
              </ul>
            </div>

            <!-- Timeline Items -->
            <div class="space-y-4">
              <!-- Item 1 -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono font-bold text-xs bg-gray-200 text-gray-800 px-2.5 py-0.5 rounded">05.30 – 06.00</span>
                  <span class="text-[11px] text-gray-500 font-semibold">Morning Breakfast</span>
                </div>
                <h4 class="font-bold text-sm text-gray-900">Bangun, Persiapan &amp; Sarapan Keluarga Groom</h4>
                <p class="text-xs text-gray-600">Sarapan pagi di hotel bersama keluarga inti. Menyiapkan outfit &amp; perlengkapan yang akan difoto.</p>
              </div>

              <!-- Item 2 -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono font-bold text-xs bg-blue-100 text-blue-800 px-2.5 py-0.5 rounded">06.00 – 09.00</span>
                  <span class="text-[11px] font-semibold text-blue-700">MUA: Veli Bridal</span>
                </div>
                <h4 class="font-bold text-sm text-gray-900">Sesi Makeup Groom &amp; Keluarga</h4>
                <div class="text-xs text-gray-700 space-y-1">
                  <div class="flex justify-between border-b border-gray-200/50 py-1">
                    <span>Makeup Mama (Ny. Susana)</span>
                    <span class="font-semibold font-mono">06.00 – 07.30</span>
                  </div>
                  <div class="flex justify-between border-b border-gray-200/50 py-1">
                    <span>Makeup Ipar (Carolina)</span>
                    <span class="font-semibold font-mono">07.30 – 09.00</span>
                  </div>
                  <div class="flex justify-between py-1">
                    <span>Makeup Groom (Hendry)</span>
                    <span class="font-semibold font-mono">08.00</span>
                  </div>
                </div>
                <div class="text-[11px] bg-amber-50 text-amber-900 p-2 rounded-xl mt-2 border border-amber-200/50">
                  <strong>Pakaian:</strong> Gaun Mama by Veli Bridal. Dasi Papa &amp; Brother dibawa sendiri.
                </div>
              </div>

              <!-- Item 3 -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono font-bold text-xs bg-green-100 text-green-800 px-2.5 py-0.5 rounded">08.00 – 09.00</span>
                  <span class="text-[11px] font-semibold text-green-700">Vendor Foto: Arpang (Standby 08.00)</span>
                </div>
                <h4 class="font-bold text-sm text-gray-900">Beauty Groom &amp; Prosesi Bersama Orang Tua</h4>
                <ul class="text-xs text-gray-600 list-disc list-inside space-y-1">
                  <li>Pemasangan jas oleh kedua orang tua</li>
                  <li>Pemberian Hand Bouquet (HB) oleh Mama ke Hendry</li>
                  <li>Foto Groom berdua dengan orang tua</li>
                  <li>Foto Groom bersama Orang Tua &amp; Saudara Kandung</li>
                </ul>

                <div class="mt-2 text-xs bg-white p-3 rounded-xl border border-gray-200 space-y-1.5">
                  <p class="font-bold text-gray-800 text-[11px] uppercase tracking-wider">Barang Display Di Atas Kasur (Untuk Foto Detail):</p>
                  <p class="text-[12px] text-gray-600">Hand bouquet, Undangan, Cincin, Jas, dasi, sepatu, jam tangan, ikat pinggang.</p>
                  <div class="pt-1 text-[11px] text-gray-500 flex flex-wrap gap-2">
                    <span class="bg-gray-100 px-2 py-0.5 rounded">Corsage Groom (1): Chelle</span>
                    <span class="bg-gray-100 px-2 py-0.5 rounded">Corsage Papa (2): Chelle</span>
                    <span class="bg-gray-100 px-2 py-0.5 rounded">Corsage Sibling (3): Chelle</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- BRIDE PREPARATION CARD -->
          <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-sm border border-gray-200/80 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-gray-100">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-full bg-pink-50 text-pink-700 flex items-center justify-center font-bold text-sm">👰</span>
                <div>
                  <h3 class="font-bold text-lg text-gray-900">Persiapan Tempat Wanita (Valensia)</h3>
                  <p class="text-xs text-gray-500">Kamar Pengantin Wanita • Harris Puri Mansion</p>
                </div>
              </div>
              <span class="text-[11px] font-bold bg-pink-100 text-pink-800 px-2.5 py-1 rounded-full uppercase tracking-wider">Keluarga Bride</span>
            </div>

            <!-- Members list -->
            <div class="bg-gray-50 rounded-2xl p-4 text-xs text-gray-700 space-y-2 border border-gray-100">
              <p class="font-bold uppercase tracking-wider text-gray-500 text-[10px]">Keluarga Yang Menginap:</p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                <li><span class="font-semibold">Bride:</span> Valensia Huang</li>
                <li><span class="font-semibold">Papa:</span> Tn. Bong Ket Hau</li>
                <li><span class="font-semibold">Mama:</span> Ny. Liauw Su San</li>
                <li><span class="font-semibold">Saudara:</span> Willy Huang &amp; Lisa Adiputra &amp; Owen</li>
              </ul>
            </div>

            <!-- Timeline Items -->
            <div class="space-y-4">
              <!-- Item 1 -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono font-bold text-xs bg-gray-200 text-gray-800 px-2.5 py-0.5 rounded">05.30 – 06.00</span>
                  <span class="text-[11px] text-gray-500 font-semibold">Morning Breakfast</span>
                </div>
                <h4 class="font-bold text-sm text-gray-900">Morning Call &amp; Sarapan Pagi Bride</h4>
                <p class="text-xs text-gray-600">Sarapan pagi bersama orang tua dan keluarga, membersihkan wajah &amp; bersiap untuk makeup.</p>
              </div>

              <!-- Item 2 -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono font-bold text-xs bg-pink-100 text-pink-800 px-2.5 py-0.5 rounded">06.00 – 09.00</span>
                  <span class="text-[11px] font-semibold text-pink-700">MUA: Veli Bridal</span>
                </div>
                <h4 class="font-bold text-sm text-gray-900">Make Up Bride, Mama &amp; Ipar</h4>
                <div class="text-xs text-gray-700 space-y-1">
                  <div class="flex justify-between border-b border-gray-200/50 py-1">
                    <span>Makeup Mama (Ny. Liauw Su San)</span>
                    <span class="font-semibold font-mono">06.00 – 07.30</span>
                  </div>
                  <div class="flex justify-between border-b border-gray-200/50 py-1">
                    <span>Makeup Ipar (Lisa Adiputra)</span>
                    <span class="font-semibold font-mono">07.30 – 09.00</span>
                  </div>
                  <div class="flex justify-between py-1">
                    <span>Make Up Bride (Valensia)</span>
                    <span class="font-semibold font-mono">06.00 – 09.00</span>
                  </div>
                </div>
                <div class="text-[11px] bg-amber-50 text-amber-900 p-2 rounded-xl mt-2 border border-amber-200/50">
                  <strong>Pakaian:</strong> Gaun Mama by Veli Bridal. Dasi Papa &amp; Brother bawa sendiri.
                </div>
              </div>

              <!-- Item 3 -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono font-bold text-xs bg-purple-100 text-purple-800 px-2.5 py-0.5 rounded">09.00 – 09.30</span>
                  <span class="text-[11px] font-semibold text-purple-700">Fitter Veli Bridal (Standby 08.00)</span>
                </div>
                <h4 class="font-bold text-sm text-gray-900">Foto Mannequin &amp; Ganti Wedding Gown</h4>
                <p class="text-xs text-gray-600">Sesi foto bersama Mannequin dan Robe dari Bridal. Dibantu fitter memakai gaun pengantin.</p>
              </div>

              <!-- Item 4 -->
              <div class="p-4 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="font-mono font-bold text-xs bg-pink-100 text-pink-800 px-2.5 py-0.5 rounded">09.30 – 10.00</span>
                  <span class="text-[11px] font-semibold text-pink-700">Prosesi Haru</span>
                </div>
                <h4 class="font-bold text-sm text-gray-900">Prosesi Pelepasan Pengantin Wanita</h4>
                <ul class="text-xs text-gray-600 list-disc list-inside space-y-1">
                  <li>Bride berdiri di tengah-tengah kedua orang tua</li>
                  <li>Pemberian Corsage dari Mama kepada Bride</li>
                  <li>Momen cium &amp; peluk hangat bersama orang tua</li>
                  <li>Foto bersama kedua orang tua &amp; saudara kandung</li>
                  <li><strong>Penutupan veil</strong> oleh orang tua (<em>Catatan: Tidak ada pantangan buka tutup veil</em>)</li>
                </ul>
              </div>
            </div>

            <!-- WO Standby Notice -->
            <div class="p-3 bg-yellow-50 border border-yellow-200 rounded-xl text-xs text-yellow-900">
              <strong>Catatan WO:</strong> Tim WO Sky standby pukul 08.00 di Ruang Crew Hotel Harris Puri Mansion (<em>Disarankan 1-2 crew WO hadir dari jam 05.30 untuk monitor makeup pagi</em>).
            </div>
          </div>

        </div>
      </section>

      <!-- ========================================== -->
      <!-- SECTION 2: PROSESI PENJEMPUTAN & BEAUTY SHOOT -->
      <!-- ========================================== -->
      <section id="section-pickup" class="schedule-section space-y-6" data-category="pickup">
        <div class="flex items-center justify-between border-b-2 border-[#314a31]/20 pb-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#314a31]">Fase 2 • 10.00 – 12.30 WIB</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#314a31]">Penjemputan, Tradisi Kamar &amp; Beauty Shoot</h2>
          </div>
