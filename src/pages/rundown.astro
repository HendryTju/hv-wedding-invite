  <!-- INTERACTIVE LOGIC: TABS, REALTIME SEARCH, CHECKBOX STORAGE & COPY SUMMARY -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. FILTER TABS
      const tabBtns = document.querySelectorAll('.tab-btn');
      const sections = document.querySelectorAll('.schedule-section');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Style tabs
          tabBtns.forEach(b => {
            b.classList.remove('bg-[#314a31]', 'text-[#fbf4e6]', 'shadow-sm');
            b.classList.add('bg-white', 'text-[#2c402c]');
          });
          btn.classList.remove('bg-white', 'text-[#2c402c]');
          btn.classList.add('bg-[#314a31]', 'text-[#fbf4e6]', 'shadow-sm');

          // Filter sections
          sections.forEach(sec => {
            const cat = sec.getAttribute('data-category');
            if (filter === 'all' || filter === cat || (filter === 'todo' && (sec.id === 'section-todo' || sec.id === 'section-inventory'))) {
              sec.classList.remove('hidden');
            } else {
              sec.classList.add('hidden');
            }
          });
        });
      });

      // 2. REALTIME SEARCH
      const searchInput = document.getElementById('schedule-search');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase().trim();
          
          if (!query) {
            // Restore current tab view
            const activeTab = document.querySelector('.tab-btn.bg-\\[\\#314a31\\]');
            if (activeTab) activeTab.click();
            return;
          }

          // Search within all sections
          sections.forEach(sec => {
            const text = sec.innerText.toLowerCase();
            if (text.includes(query)) {
              sec.classList.remove('hidden');
            } else {
              sec.classList.add('hidden');
            }
          });
        });
      }

      // 3. PERSISTENT CHECKBOXES (LOCAL STORAGE)
      const TODO_STORAGE_KEY = 'hv_rundown_todos_v1';
      let checkedTodos = {};
      try {
        checkedTodos = JSON.parse(localStorage.getItem(TODO_STORAGE_KEY) || '{}');
      } catch (err) {
        checkedTodos = {};
      }

      const checkboxes = document.querySelectorAll('.todo-checkbox');
      checkboxes.forEach(cb => {
        const id = cb.getAttribute('data-todo');
        if (id && checkedTodos[id]) {
          cb.checked = true;
          cb.closest('label')?.classList.add('opacity-50', 'line-through');
        }

        cb.addEventListener('change', () => {
          if (cb.checked) {
            checkedTodos[id] = true;
            cb.closest('label')?.classList.add('opacity-50', 'line-through');
          } else {
            delete checkedTodos[id];
            cb.closest('label')?.classList.remove('opacity-50', 'line-through');
          }
          localStorage.setItem(TODO_STORAGE_KEY, JSON.stringify(checkedTodos));
        });
      });

      // 4. COPY TEXT SUMMARY FOR WHATSAPP
      const copyBtn = document.getElementById('copy-summary-btn');
      const copyTextSpan = document.getElementById('copy-text');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const rundownSummary = `*RINGKASAN RUNDOWN PERNIKAHAN HENDRY & VALENSIA*
Minggu, 6 Desember 2026

⏰ 05.30 - 06.00: Bangun & Sarapan Pagi di Harris Hotel
⏰ 06.00 - 09.00: Make Up Bride, Groom, 2 Mama, 2 Ipar (Veli Bridal)
⏰ 08.00: Standby Vendor Foto Arpang & Fitter Bridal
